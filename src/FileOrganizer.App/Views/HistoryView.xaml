<UserControl x:Class="FileOrganizer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,8,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="История" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Каждая операция записана в журнал: откуда, куда, старое и новое имя, время. Любой пакет изменений можно отменить."/>
            <WrapPanel>
                <Button Content="Отменить последнее действие" Command="{Binding Shell.UndoLastCommand}" Style="{StaticResource AccentButton}"/>
                <TextBlock Text="Восстановить состояние до:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,8,8"/>
                <DatePicker SelectedDate="{Binding RestoreDate}" Width="140" Margin="0,0,8,8"/>
                <TextBox Text="{Binding RestoreTime}" Width="70" Margin="0,0,8,8" ToolTip="ЧЧ:ММ"/>
                <Button Content="Восстановить" Command="{Binding RestoreToCommand}"/>
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Batches}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding CreatedUtc, Converter={StaticResource Date}}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding DoneCount, Mode=OneWay}"/>
                                <Run Text=" операций · "/>
                                <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusText}}"/>
                                <Run Text=" · ошибок: "/>
                                <Run Text="{Binding FailedCount, Mode=OneWay}"/>
                            </TextBlock>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Открыть" Command="{Binding DataContext.OpenRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="Отменить" Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="Удалить окончательно…" Style="{StaticResource DangerButton}" ToolTip="Безвозвратно удалить файлы этого пакета из папки восстановления"
                                        Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Изменения" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Operations}" Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{Binding Kind, Mode=OneWay, Converter={StaticResource KindText}}" FontWeight="SemiBold" Foreground="{Binding Kind, Converter={StaticResource MarkBrush}}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Было: "/>
                                    <Run Text="{Binding Source, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Стало: "/>
                                    <Run Text="{Binding Destination, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="{Binding ExecutedUtc, Mode=OneWay, Converter={StaticResource Date}}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusText}}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Error, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
