<Window x:Class="FileOrganizer.App.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение файлов" Width="1000" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" FontFamily="{StaticResource UiFont}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}">
            <TextBlock x:Name="Verdict" Style="{StaticResource Body}" Text="Сравнение…"/>
        </Border>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Закрыть" Click="Close_Click" IsCancel="True" Margin="0,12,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock x:Name="LeftTitle" DockPanel.Dock="Top" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="LeftInfo" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                <TextBox x:Name="LeftText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="RightTitle" DockPanel.Dock="Top" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RightInfo" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                <TextBox x:Name="RightText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
