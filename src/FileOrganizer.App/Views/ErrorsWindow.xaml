<Window x:Class="FileOrganizer.App.Views.ErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нет доступа" Width="760" Height="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" FontFamily="{StaticResource UiFont}">
    <DockPanel Margin="20">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Закрыть" Click="Close_Click" IsCancel="True" Margin="0,12,0,0"/>
        <ListBox x:Name="List" Style="{StaticResource PlainList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Body}"/>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Message, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
