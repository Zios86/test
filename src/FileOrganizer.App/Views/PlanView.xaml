<UserControl x:Class="FileOrganizer.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileOrganizer.App.ViewModels">
    <DockPanel Margin="24,8,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Будет выполнено" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Все предложенные изменения. Снимите флажок с того, что делать не нужно. Предложения со средней и низкой уверенностью не отмечены — решите сами. Ничего не выполняется до нажатия «Применить»."/>

            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Shell.SimulationMode, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Отключить режим" Command="{Binding Shell.DisableSimulationCommand}" Margin="12,0,0,0"/>
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                               Text="Включён режим «Только посмотреть»: план можно изучить, но применить его нельзя. Файловая система не изменяется."/>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10">
                <UniformGrid Rows="1">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Перемещено" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.Moved}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MarkMove}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Переименовано" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.Renamed}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MarkRename}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Создано папок" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.FoldersCreated}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MarkCreate}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Удалено пустых каталогов" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.EmptyFoldersRemoved}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MarkDelete}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="В папку восстановления" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.SentToRecovery}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MarkDelete}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Конфликты имён" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.Conflicts}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Не отмечено" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary.NotSelected}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <WrapPanel Margin="0,4,0,8">
                <Button Command="{Binding ApplyCommand}" Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/><TextBlock Text="Применить"/></StackPanel>
                </Button>
                <Button Content="Отметить всё" Command="{Binding SelectAllCommand}"/>
                <Button Content="Снять все отметки" Command="{Binding SelectNoneCommand}"/>
                <Button Content="Показать структуру" Command="{Binding ShowStructureCommand}"/>
                <Button Content="+ Сортировка по типам" Command="{Binding SortByTypeCommand}"/>
                <Button Content="+ Умная сортировка" Command="{Binding SmartSortCommand}"/>
                <Button Content="+ По моим правилам" Command="{Binding RulesSortCommand}"/>
                <Button Content="Очистить план" Command="{Binding ClearCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Body}" Margin="0,12" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Text="План пуст. Выполните анализ и выберите «Навести порядок», «Умная сортировка» или добавьте действия на страницах «Дубликаты», «Пустые папки», «Названия» и др."/>
        </StackPanel>

        <ListBox ItemsSource="{Binding View}" Style="{StaticResource PlainList}"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True" Margin="0,4,0,4">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' — {0} действий'}" Foreground="{DynamicResource TextSecondary}" Margin="6,0,12,0"/>
                                                    <Button Style="{StaticResource LinkButton}" Content="отметить все"
                                                            Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}"/>
                                                    <Button Style="{StaticResource LinkButton}" Content="снять"
                                                            Command="{Binding DataContext.SelectNoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter Margin="0,6,0,0"/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlanItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}">
                                <Run Text="{Binding Kind, Mode=OneWay, Converter={StaticResource KindText}}" FontWeight="SemiBold"
                                     Foreground="{Binding Kind, Converter={StaticResource MarkBrush}}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Source, Mode=OneWay}"/>
                                <Run Text="  →  " Foreground="{DynamicResource TextSecondary}"/>
                                <Run Text="{Binding Destination, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="Причина: "/>
                                <Run Text="{Binding Reason, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Файл с таким именем уже есть:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="320" ItemsSource="{x:Static vm:PlanItemViewModel.Resolutions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Resolution, Mode=TwoWay}"/>
                                <Button Content="Сравнить" Margin="8,0,0,0" Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Border Style="{StaticResource Badge}" Background="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Confidence, Converter={StaticResource Percent}}" Foreground="White" FontSize="12" FontWeight="SemiBold" ToolTip="{Binding ConfidenceText}"/>
                            </Border>
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <Button Style="{StaticResource LinkButton}" Content="показать" HorizontalAlignment="Right" Margin="0,4,0,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
