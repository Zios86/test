<UserControl x:Class="FileOrganizer.App.Views.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:FileOrganizer.Core.Planning;assembly=FileOrganizer.Core">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type p:PreviewNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding Mark, Converter={StaticResource MarkBrush}}"
                        Visibility="{Binding Mark, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Mark, Converter={StaticResource MarkText}}" Margin="10,0,0,0" FontSize="12"
                           Foreground="{Binding Mark, Converter={StaticResource MarkBrush}}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Size, Converter={StaticResource Size}}" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24,8,24,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Структура" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Слева — как сейчас (с отметками, что изменится), справа — как будет после применения выбранных действий."/>
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Обозначения:" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MarkMove}" Margin="0,0,4,0"/><TextBlock Text="Переместить" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MarkRename}" Margin="0,0,4,0"/><TextBlock Text="Переименовать" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MarkMerge}" Margin="0,0,4,0"/><TextBlock Text="Объединить" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MarkDelete}" Margin="0,0,4,0"/><TextBlock Text="Удалить после подтверждения" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MarkCreate}" Margin="0,0,4,0"/><TextBlock Text="Создать" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <TextBlock Text="без отметки — оставить" Style="{StaticResource Caption}"/>
            </WrapPanel>
            <WrapPanel Visibility="{Binding Shell.HasReport, Converter={StaticResource BoolToVis}}">
                <Button Content="Сортировка по типам" Command="{Binding Shell.Plan.SortByTypeCommand}"/>
                <Button Content="Умная сортировка" Command="{Binding Shell.Plan.SmartSortCommand}"/>
                <Button Content="По моим правилам" Command="{Binding Shell.Plan.RulesSortCommand}"/>
                <Button Content="Будет выполнено →" Style="{StaticResource AccentButton}" Command="{Binding Shell.NavigateCommand}" CommandParameter="{Binding Shell.Plan}"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" Margin="0,8"
                   Visibility="{Binding Shell.HasReport, Converter={StaticResource InvBoolToVis}}" Text="Выберите папку и выполните анализ."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Текущая структура" Style="{StaticResource SectionTitle}" Margin="0,4,0,6"/>
                <TreeView ItemsSource="{Binding Current}" VirtualizingPanel.IsVirtualizing="True"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Предлагаемая структура" Style="{StaticResource SectionTitle}" Margin="0,4,0,6"/>
                <Grid>
                    <TreeView ItemsSource="{Binding Proposed}" VirtualizingPanel.IsVirtualizing="True"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="16" Visibility="{Binding HasPlan, Converter={StaticResource InvBoolToVis}}"
                               Text="Предложений пока нет. Нажмите «Умная сортировка» или «Сортировка по типам» — здесь появится будущая структура."/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
