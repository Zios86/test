<UserControl x:Class="FileOrganizer.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,8,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Поиск" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Поиск по результатам последнего анализа: по имени (можно маску *.pdf), расширению, размеру, дате, папке, содержимому документов и тегам."/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Имя" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}" Margin="0,0,12,6"/>
                    <TextBlock Grid.Column="2" Text="Расширение" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Column="3" Text="{Binding Extension}" Margin="0,0,12,6"/>
                    <TextBlock Grid.Column="4" Text="Тип" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Text" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Text="Размер от, МБ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinSizeMb}" Margin="0,0,12,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="до, МБ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaxSizeMb}" Margin="0,0,12,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Папка содержит" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding FolderPart}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Text="Изменён с" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding From}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="по" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Row="2" Grid.Column="3" SelectedDate="{Binding To}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Текст внутри" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Content}" ToolTip="Ищет в TXT, DOCX, XLSX, PPTX, ODT, RTF, PDF. Может занять время."/>
                </Grid>
            </Border>
            <WrapPanel>
                <TextBlock Text="Тег" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Width="160" IsEditable="True" Text="{Binding Tag}" ItemsSource="{Binding AllTags}" Margin="0,0,8,8"/>
                <Button Content="Найти" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" IsDefault="True"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="8,0,0,8"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Виртуальный тег для отмеченных:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Width="160" IsEditable="True" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AllTags}" Margin="0,0,8,8"/>
                <Button Content="Присвоить" Command="{Binding AddTagCommand}"/>
                <Button Content="Снять" Command="{Binding RemoveTagCommand}"/>
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,8"/>
            </WrapPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource FileRowTemplate}"/>
    </DockPanel>
</UserControl>
