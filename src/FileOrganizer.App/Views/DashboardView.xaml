<UserControl x:Class="FileOrganizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Главная" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Сначала программа разбирается в беспорядке, затем предлагает порядок и показывает все изменения. Применяется только то, что вы подтвердите, — и всё можно отменить."/>

            <!-- Папки «Разобрать» -->
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding Shell.InboxMessage, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Разобрать" Style="{StaticResource AccentButton}" Command="{Binding SortInboxCommand}" Margin="12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Shell.InboxMessage}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Нет папки -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Shell.HasFolder, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="С чего начать" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Body}" Text="1. Нажмите «Выбрать папку» — например, «Загрузки», «Рабочий стол» или «Документы».&#10;2. Нажмите «Анализировать» или выберите режим ниже.&#10;3. Посмотрите предложения и будущую структуру, отметьте нужное и нажмите «Применить»."/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="При первом запуске включён режим «Только посмотреть»: программа ничего не меняет на диске."/>
                </StackPanel>
            </Border>

            <!-- Недавние папки -->
            <StackPanel Visibility="{Binding Shell.HasReport, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="Недавние папки" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding RecentFolders.Count, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding RecentFolders}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Command="{Binding DataContext.PickRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" MaxWidth="360" ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Основные действия -->
            <TextBlock Text="Основные действия" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
            <WrapPanel>
                <Button Command="{Binding Shell.AnalyzeCommand}" ToolTip="Просканировать папку и показать, что в ней находится">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="Анализировать"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.TidyUpCommand}" Style="{StaticResource AccentButton}" ToolTip="Анализ → предложения → предпросмотр. Ничего не выполняется без подтверждения.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/><TextBlock Text="Навести порядок"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.GoFindDuplicates}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Найти дубликаты"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.SmartSortCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Margin="0,0,8,0"/><TextBlock Text="Умная сортировка"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.GoEmptyFolders}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0"/><TextBlock Text="Очистить пустые папки"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.GoLargeFiles}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB05;" Margin="0,0,8,0"/><TextBlock Text="Найти крупные файлы"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.GoOldFiles}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Margin="0,0,8,0"/><TextBlock Text="Найти старые файлы"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.NavigateCommand}" CommandParameter="{Binding Shell.History}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,8,0"/><TextBlock Text="История изменений"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.UndoLastCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,8,0"/><TextBlock Text="Отменить изменения"/></StackPanel>
                </Button>
                <Button Command="{Binding Shell.NavigateCommand}" CommandParameter="{Binding Shell.Settings}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0"/><TextBlock Text="Настройки"/></StackPanel>
                </Button>
            </WrapPanel>

            <!-- Режимы -->
            <TextBlock Text="Режимы" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
            <WrapPanel>
                <Button Style="{StaticResource TileButton}" Command="{Binding Shell.QuickCleanupCommand}">
                    <StackPanel>
                        <TextBlock Text="Быстрая уборка" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Дубли, пустые папки, старые установщики, крупные файлы"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Command="{Binding Shell.SmartSortCommand}">
                    <StackPanel>
                        <TextBlock Text="Умная сортировка" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Понятная структура папок по типам, темам и проектам"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Command="{Binding Shell.DeepAnalysisCommand}">
                    <StackPanel>
                        <TextBlock Text="Глубокий анализ" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Анализ текста документов (локально), ИИ — если включён"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Command="{Binding Shell.ManualModeCommand}">
                    <StackPanel>
                        <TextBlock Text="Ручной режим" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Вы сами задаёте правила: «если… то переместить в…»"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Результаты анализа -->
            <StackPanel Visibility="{Binding Shell.HasReport, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Shell.ErrorCount, Converter={StaticResource BoolToVis}}" Margin="0,8,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Открыть список" Command="{Binding Shell.ShowErrorsCommand}" Margin="12,0,0,0"/>
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                            <Run Text="Нет доступа к некоторым файлам или папкам:"/>
                            <Run Text="{Binding Shell.ErrorCount, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=". Остальное проанализировано."/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <TextBlock Text="Сводка" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Width="260" Height="120"
                                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="13"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource CardValue}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Проанализировано" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Width="200" Height="70" Padding="12,8"
                                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Распределение места по типам" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="12" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Run Text="{Binding Size, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Count, Mode=OneWay}"/>
                                        <Run Text=" файлов"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
