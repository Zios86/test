<UserControl x:Class="FileOrganizer.App.Views.EmptyFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,8,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Пустые папки" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Полностью пустые папки, папки только со служебными файлами (Thumbs.db, desktop.ini) и цепочки вложенных пустых папок. Удаляются только после подтверждения; служебные файлы уходят в папку восстановления."/>
            <WrapPanel>
                <Button Content="Удалить отмеченные (добавить в план)" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource EmptyState}" Text="Пустых папок не найдено.">
            <TextBlock.Visibility>
                <MultiBinding Converter="{StaticResource EmptyVis}">
                    <Binding Path="Shell.HasReport"/>
                    <Binding Path="Items.Count"/>
                </MultiBinding>
            </TextBlock.Visibility>
        </TextBlock>
        <ListBox ItemsSource="{Binding Items}" Style="{StaticResource PlainList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="показать" VerticalAlignment="Center"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
