<UserControl x:Class="FileOrganizer.App.Views.NamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RenameRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OldName}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
                    <TextBlock Text="{Binding Problem}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox Grid.Column="3" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,8,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Названия" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Бессмысленные и хаотичные названия и массовое переименование по шаблону. Имена не меняются автоматически — сначала «Было → Станет»."/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Плохие названия">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Переименовать отмеченные (в план)" Command="{Binding AddBadNamesCommand}" Style="{StaticResource AccentButton}"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,8" Text="Предложенное имя можно исправить вручную."/>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding BadNames}" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource RenameRowTemplate}"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Массовое переименование">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Папка" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Шаблон" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Text" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="или свой" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                     ToolTip="{}{date} {year} {month} {name} {clean} {parent} {type} {project} {client} {doc} {counter:000}"/>
                            <TextBlock Grid.Row="2" Text="Проект" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Клиент" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Text="Тип документа" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Только типы" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="Например: pdf, docx (пусто — все)"/>
                            <TextBlock Grid.Row="4" Text="Заменить" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="на" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Предпросмотр: Было → Станет" Command="{Binding PreviewCommand}"/>
                        <Button Content="Переименовать отмеченные (в план)" Command="{Binding AddPreviewCommand}" Style="{StaticResource AccentButton}"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,8" Text="Пример результата: 2026-10-12_Протокол_совещания.docx"/>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Preview}" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource RenameRowTemplate}"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
