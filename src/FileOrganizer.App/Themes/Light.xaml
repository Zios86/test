<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема: Light -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="NavBackground" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1975C5"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PressedBackground" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="SelectedNav" Color="#DDE7F2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="InfoBannerBackground" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="WarningBannerBackground" Color="#FFF4CE"/>
    <!-- Цвета изменений в дереве -->
    <SolidColorBrush x:Key="MarkMove" Color="#0067C0"/>
    <SolidColorBrush x:Key="MarkRename" Color="#8A3FC4"/>
    <SolidColorBrush x:Key="MarkMerge" Color="#007C80"/>
    <SolidColorBrush x:Key="MarkDelete" Color="#C42B1C"/>
    <SolidColorBrush x:Key="MarkCreate" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="MarkKeep" Color="#6E6E6E"/>
</ResourceDictionary>
