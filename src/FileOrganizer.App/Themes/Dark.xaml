<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема: Dark -->
    <SolidColorBrush x:Key="WindowBackground" Color="#202020"/>
    <SolidColorBrush x:Key="NavBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#62CAFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#000000"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#383838"/>
    <SolidColorBrush x:Key="PressedBackground" Color="#444444"/>
    <SolidColorBrush x:Key="InputBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InputBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SelectedNav" Color="#323E4A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="InfoBannerBackground" Color="#1E3247"/>
    <SolidColorBrush x:Key="WarningBannerBackground" Color="#433519"/>
    <!-- Цвета изменений в дереве -->
    <SolidColorBrush x:Key="MarkMove" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="MarkRename" Color="#C79BF2"/>
    <SolidColorBrush x:Key="MarkMerge" Color="#4FD1D9"/>
    <SolidColorBrush x:Key="MarkDelete" Color="#FF99A4"/>
    <SolidColorBrush x:Key="MarkCreate" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="MarkKeep" Color="#9E9E9E"/>
</ResourceDictionary>
