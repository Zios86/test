<Window x:Class="FileOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileOrganizer.App.ViewModels"
        xmlns:v="clr-namespace:FileOrganizer.App.Views"
        Title="Умный файловый организатор" Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StructureViewModel}"><v:StructureView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlanViewModel}"><v:PlanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><v:DuplicatesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpaceViewModel}"><v:SpaceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OldFilesViewModel}"><v:OldFilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmptyFoldersViewModel}"><v:EmptyFoldersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NamesViewModel}"><v:NamesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimilarFoldersViewModel}"><v:SimilarFoldersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MisplacedViewModel}"><v:MisplacedView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TempFilesViewModel}"><v:TempFilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><v:ProjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Навигация -->
        <DockPanel Background="{DynamicResource NavBackground}">
            <StackPanel DockPanel.Dock="Top" Margin="18,18,12,14" Orientation="Horizontal">
                <Image Source="Assets/app.ico" Width="28" Height="28" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Файловый" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="организатор" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Режим «Только посмотреть» -->
            <Border DockPanel.Dock="Bottom" Margin="10" Padding="12,10" CornerRadius="6" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <StackPanel>
                    <CheckBox IsChecked="{Binding SimulationMode}" FontWeight="SemiBold" Content="Только посмотреть"/>
                    <TextBlock Style="{StaticResource Caption}" Visibility="{Binding SimulationMode, Converter={StaticResource BoolToVis}}"
                               Text="Файлы не изменяются. Можно смотреть анализ и предложения."/>
                    <TextBlock Style="{StaticResource Caption}" Visibility="{Binding SimulationMode, Converter={StaticResource InvBoolToVis}}"
                               Text="Изменения выполняются только после подтверждения и могут быть отменены."/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Mode="OneWay">
                                        <MultiBinding.Converter>
                                            <v:ReferenceEqualsConverter/>
                                        </MultiBinding.Converter>
                                        <Binding/>
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Содержимое -->
        <DockPanel Grid.Column="1">
            <!-- Верхняя панель: папка и основные действия -->
            <Border DockPanel.Dock="Top" Padding="24,14,24,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{Binding Plan}" ToolTip="Экран «Будет выполнено»: все предложенные изменения">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,8,0"/>
                                <TextBlock Text="План: "/>
                                <TextBlock Text="{Binding PlanCount}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UndoLastCommand}" ToolTip="Отменить последнее выполненное действие">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,8,0"/>
                                <TextBlock Text="Отменить изменения"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PickFolderCommand}" Style="{StaticResource AccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0"/>
                                <TextBlock Text="Выбрать папку"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="4,0,0,8">
                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="520" ToolTip="{Binding Folder}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Прогресс -->
            <Border DockPanel.Dock="Top" Margin="24,0,24,8" Style="{StaticResource InfoBanner}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding StopCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0"/>
                            <TextBlock Text="Остановить"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <ProgressBar Margin="0,8,0,0" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Margin="24,0,24,8" Style="{StaticResource InfoBanner}"
                    Visibility="{Binding ShowNoReportHint, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Анализировать" Style="{StaticResource AccentButton}" Command="{Binding AnalyzeCommand}" Margin="12,0,0,0"/>
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                               Text="Здесь появятся результаты после анализа. Выберите папку и нажмите «Анализировать»."/>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
        </DockPanel>
    </Grid>
</Window>
