<Application x:Class="FileOrganizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileOrganizer.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <ResourceDictionary Source="Themes/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InvBool"/>
            <conv:SizeConverter x:Key="Size"/>
            <conv:NumberConverter x:Key="Number"/>
            <conv:DateConverter x:Key="Date"/>
            <conv:PercentConverter x:Key="Percent"/>
            <conv:ChangeMarkToBrushConverter x:Key="MarkBrush"/>
            <conv:ChangeMarkToTextConverter x:Key="MarkText"/>
            <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush"/>
            <conv:OperationKindToTextConverter x:Key="KindText"/>
            <conv:OperationStatusToTextConverter x:Key="StatusText"/>
            <conv:CategoryToTextConverter x:Key="CategoryText"/>
            <conv:RelativePathConverter x:Key="RelPath"/>
            <conv:EmptyStateVisibilityConverter x:Key="EmptyVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
